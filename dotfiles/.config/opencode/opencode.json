{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": true,
  "lsp": true,
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      { "action": "provider.use", "resource": "local", "effect": "allow" }
    ]
  },
  "providers": {
    "local": {
      "name": "Local LLM",
      "package": "aisdk:@ai-sdk/openai-compatible",
      "settings": {
        "baseURL": "http://{env:LLM_API_HOST}/v1",
        "apiKey": "local"
      },
      "models": {
        "{env:LLM_MODEL}": {
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": {env:LLM_MAX_CONTEXT},
            "output": {env:LLM_MAX_OUTPUT}
          },
          "settings": {
            "reasoningEffort": "high"
          },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none" } },
            { "id": "minimal", "settings": { "reasoningEffort": "minimal" } },
            { "id": "low", "settings": { "reasoningEffort": "low" } },
            { "id": "medium", "settings": { "reasoningEffort": "medium" } },
            { "id": "high", "settings": { "reasoningEffort": "high" } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh" } },
            { "id": "max", "settings": { "reasoningEffort": "max" } }
          ]
        }
      }
    }
  },
  "model": "local/{env:LLM_MODEL}",
  "small_model": "local/{env:LLM_MODEL}",
  "permission": {
    "external_directory": "allow",
    "read": "allow",
    "edit": {
      "*": "allow",
      "~/**": "ask",
      "/**": "ask"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow",
        "external_directory": {
          "/tmp/*": "allow"
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "--yes",
        "--prefer-offline",
        "@playwright/mcp@0.0.83",
        "--browser",
        "firefox"
      ],
      "timeout": 30000,
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": [
        "blender-mcp"
      ],
      "enabled": true,
      "environment": {
        "BLENDER_MCP_HOST": "localhost",
        "BLENDER_MCP_PORT": "9876"
      }
    },
    "slack": {
      "type": "local",
      "command": [
        "npx", "--yes", "slack-mcp-server@1.3.0", "--transport", "stdio"
      ],
      "timeout": 30000,
      "enabled": true,
      "environment": {
        "SLACK_MCP_XOXP_TOKEN": "{file:~/.secrets/slack-token}",
        "SLACK_MCP_ENABLED_TOOLS": "channels_list,conversations_history,conversations_replies,conversations_search_messages,conversations_unreads,users_search",
        "SLACK_MCP_LOG_LEVEL": "warn"
      }
    },
    "thunderbird": {
      "type": "local",
      "command": [
        "tbird-mcp"
      ],
      "timeout": 30000,
      "enabled": true
    }
  },
  "formatter": {
    "python": {
      "command": ["sh", "-c", "isort - | autopep8 -"],
      "extensions": [".py"]
    },
    "typescript": {
      "command": [
        "npx", "prettier", "--stdin-filepath", "{filename}",
        "--single-quote", "--semi", "--tab-width", "2",
        "--print-width", "100", "--trailing-comma", "none"
      ],
      "extensions": [".ts", ".tsx", ".js", ".jsx"]
    }
  }
}
