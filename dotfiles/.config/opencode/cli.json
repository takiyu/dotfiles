{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "tango-lx"
  },
  "keybinds": {
    "leader": "none",
    "app.exit": "ctrl+q",
    "command.palette.show": "ctrl+r",
    "session.sidebar.toggle": "ctrl+f",
    "session.list": "ctrl+l",
    "session.toggle.thinking": "ctrl+t",
    "variant.cycle": "ctrl+y",
    "session.tab.close": ["ctrl+d", "ctrl+c", "f4"],
    "session.tab.reopen": ["ctrl+x", "ctrl+b", "f5"],
    "session.tab.previous": "f2",
    "session.tab.next": "f3",
    "session.new": "ctrl+o",
    "open.menu": "ctrl+shift+o",
    "session.message.user.previous": "ctrl+p",
    "session.message.user.next": "ctrl+n",
    "session.last": ["ctrl+g", "end"],
    "prompt.queue": "linefeed",
    "model.cycle_recent": "none",
    "app.clear": "none",
    "session.pin.toggle": "none",
    "session.delete": "none",
    "session.background": "none",
    "stash.delete": "none",
    "model.dialog.favorite": "none",
    "permission.prompt.fullscreen": "none",
    "composer.subagent.interrupt": "none",
    "composer.shell.kill": "none",
    "dialog.move_session.delete": "none",
    "queued_prompt.delete": "none",
    "session.rename": "none",
    "dialog.move_session.refresh": "none",
    "dialog.plugins.check": "none",
    "dialog.integration.rename": "none",
    "diff.half_page.down": "none",
    "diff.page.up": "pageup",
    "diff.page.down": "pagedown",
    "input.move.left": "left",
    "input.move.right": "right",
    "input.delete": "delete,shift+delete",
    "session.first": ["home"],
    "dialog.select.prev": "up",
    "dialog.select.next": "down",
    "prompt.autocomplete.prev": "up",
    "prompt.autocomplete.next": "down"
  },
  "scroll": {
    "speed": 10,
    "acceleration": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
